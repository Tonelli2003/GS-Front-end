# Copie para .env e preencha. O arquivo .env NUNCA deve ir para o Git.

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=coloque_sua_chave_aqui
# Modelos atuais da Groq (llama-3.3 e llama-4-scout foram desligados em 2026).
# Confira os disponíveis na sua conta com: python -m scripts.listar_modelos
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo
LLM_TIMEOUT=30

# --- API ---
# Origens permitidas no CORS, separadas por vírgula (nunca use *)
ALLOWED_ORIGINS=http://localhost:8501
# Código de acesso do perfil Gestor (troque por um valor forte)
GESTOR_TOKEN=troque-este-codigo
DB_PATH=data/bairro_em_dia.db
# true = cria 60 relatos FICTÍCIOS de demonstração na primeira execução
SEED_DEMO=true

# --- Front-end ---
API_URL=http://localhost:8000
